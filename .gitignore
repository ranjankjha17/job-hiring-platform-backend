### Node.js/Express .gitignore

# 💻 Dependencies and Build Artifacts
# ------------------------------------
/node_modules
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*
/pnpm-debug.log*
/lerna-debug.log*

# 📦 Dependency/Lock files (if you prefer to NOT commit them)
# Uncomment the following if you manage dependencies outside of the repo (e.g., CI/CD)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# 🛠 Build Output and Compilation
# ------------------------------------
/dist
/build
/out
/coverage
/.nyc_output
# For TypeScript (if used)
/*.tsbuildinfo

# ⚙ Environment and Configuration
# ------------------------------------
# Crucial: Don't commit sensitive environment variables!
.env
.env.local
.env.*.local
.DS_Store

# 📝 Logging and History
# ------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
testem.log

# 🧪 Testing and Debugging
# ------------------------------------
# IDE / Editor temporary files
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history

# WebStorm / IntelliJ
.idea

# Vim/NeoVim swap files
*~
# Other editor files
\#*#
.swp
.swo
.swm
.swn
.bak
*.orig

# 🍏 macOS specific files
# ------------------------------------
.DS_Store
.Trashes
ehthumbs.db
Thumbs.db